  sheet.getRange(1, 1, values.length, SEED_HEADERS.length).setValues(values);
  sheet.setFrozenRows(1);
  sheet.getRange('A:A').setNumberFormat('yyyy-mm-dd');
  sheet.getRange('B:B').setNumberFormat('yyyy-mm-dd');
  sheet.getRange('C:D').setNumberFormat('HH:mm');
  SpreadsheetApp.getUi().alert('Готово: записано ' + SEED_ROWS.length + ' событий на лист «' + SEED_SHEET_NAME + '».');
}
